extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/release-readiness.css')
    link(rel='stylesheet', href='/stylesheets/custom/release-readiness.css')

    script(src='/javascripts/apps/release-readiness.js')
    script(src='/javascripts/custom/release-readiness.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Item, approval, change, and release blocker readiness
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #release-readiness
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Use item, approval, and change workspaces to validate release blockers before adding approval or lifecycle write actions.
