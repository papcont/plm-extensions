extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/dpp-readiness.css')
    link(rel='stylesheet', href='/stylesheets/custom/dpp-readiness.css')

    script(src='/javascripts/apps/dpp-readiness.js')
    script(src='/javascripts/custom/dpp-readiness.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Product, component, supplier, compliance, lifecycle, and document readiness
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #dpp-readiness
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Validate product, supplier, compliance, and document gaps before adding registry submission, QR/data carriers, or certification workflows.
