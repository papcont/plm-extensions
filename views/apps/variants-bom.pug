extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/variants-bom.css')
    link(rel='stylesheet', href='/stylesheets/custom/variants-bom.css')

    script(src='/javascripts/apps/variants-bom.js')
    script(src='/javascripts/custom/variants-bom.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title=title
            #header-subtitle
            #header-toolbar
                .button#button-open.with-icon.icon-search(title='Zur Startseite: Baugruppe suchen oder aus der Liste wählen') Startseite
                .button#button-save.disabled.default.with-icon.icon-create(title='Auf Duplikate prüfen und die Varianten-Baugruppen anlegen') Variante speichern
                .button#button-variants.with-icon.icon-edit.filled(title='Zurück zur Variantenbildung: Positionen tauschen und Variante speichern') Bearbeiten
                .button#button-order-bom.with-icon.icon-list(title='Stammstückliste dieser Baugruppe auflösen und Position für Position mit der APplus-Stückliste vergleichen') Stammstückliste
                .button#button-applus-check.with-icon.icon-check(title='Zweite Ansicht zum Vergleich: was in APplus anzulegen ist und was nur APplus hat') APplus-Check
                .button#button-filter-variants.with-icon.icon-filter(title='Nur variantenfähige Positionen zeigen (GEN-TITLE1 und GEN-TITLE2 gefüllt)') Nur variantenfähige
                .button#button-toggle-viewer.with-icon.icon-viewer.filled(title='3D-Viewer ein- oder ausblenden') Viewer
                .button#button-toggle-details.with-icon.icon-panel.filled(title='Detailbereich rechts ein- oder ausblenden') Details
                #header-avatar

        #main.screen.with-viewer.with-details

            #viewer.viewer

            #bom.surface-level-1

            #item.surface-level-3
