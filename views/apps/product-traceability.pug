extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/product-traceability.css')
    link(rel='stylesheet', href='/stylesheets/custom/product-traceability.css')

    script(src='/javascripts/apps/product-traceability.js')
    script(src='/javascripts/custom/product-traceability.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Item master, documents, product context, and release evidence
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #product-traceability
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Validate item, document, product, and change links before adding document creation, item updates, or release actions.
