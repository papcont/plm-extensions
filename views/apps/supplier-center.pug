extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/supplier-center.css')
    link(rel='stylesheet', href='/stylesheets/custom/supplier-center.css')

    script(src='/javascripts/apps/supplier-center.js')
    script(src='/javascripts/custom/supplier-center.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Supplier packages, spare part requests, and sourcing readiness
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #supplier-center
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Use supplier and request workspaces to validate collaboration signals before adding package creation or supplier workflow actions.
