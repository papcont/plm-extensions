extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/condition-monitoring.css')
    link(rel='stylesheet', href='/stylesheets/apps/ai-chat.css')

    script(src='/javascripts/apps/ai-chat.js')
    script(src='/javascripts/apps/cm-format.js')
    script(src='/javascripts/apps/condition-monitoring.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Zustand, Vibration und Temperatur aus Live-Telemetrie
            #header-toolbar
                #cm-source.cm-pill(title='Telemetrie-Quelle')  Quelle: -
                #cm-pause.button.with-icon.icon-pause(title='Alle Demo-Daten pausieren / fortsetzen (Client-Abfrage + Server-Ticker)') Pause
                #cm-reset.button.icon.icon-refresh(title='Demo-Szenario neu starten')
                #header-avatar

        #condition-monitoring

            .cm-fullview
                a#cm-fullview-link(target='_blank' rel='noopener') Vollansicht öffnen ↗ · Baseline, Events, KI-Einschätzung, Maintenance Case, Ersatzteile

            .cm-pipeline
                span Telemetrie
                span.cm-pipe-arrow →
                span Gelernte Baseline (eingefroren)
                span.cm-pipe-arrow →
                span Ergebnis Condition · Anomalie · Event
                span.cm-pipe-arrow →
                span.cm-pipe-ai KI-Erklärung (nur auf Klick)
                span.cm-pipe-arrow →
                span Mensch / Maintenance Case

            #cm-asset.surface-level-2(style='display:none')
                .cm-asset-head
                    span.cm-label Asset
                    a#cm-asset-name.cm-asset-name.cm-fm-title(target='_blank' rel='noopener' title='Asset in Fusion Manage öffnen') -
                    a#cm-asset-link.cm-asset-link.cm-fm-link(target='_blank' rel='noopener') In Fusion Manage öffnen – Login erforderlich
                .cm-sensors
                    .cm-section-title Sensoren an diesem Asset
                    #cm-sensors-list
                        .cm-events-empty Wird geladen …

            #cm-parts.surface-level-2(style='display:none')
                .cm-section-title Ersatzteile dieses Assets (Service BOM) · Beschaffung
                #cm-parts-list

            //- 1 CURRENT STATE
            .cm-story-label Aktueller Maschinenzustand

            #cm-summary.surface-level-2
                .cm-tile#cm-tile-status
                    .cm-label Status
                    .cm-status-value
                        span#cm-status-dot.cm-dot
                        span#cm-status-text -
                    .cm-tile-sub#cm-status-sub
                .cm-tile
                    .cm-label Health
                    .cm-value
                        span#cm-health -
                        span.cm-unit  %
                .cm-tile#cm-tile-ai
                    .cm-label Baseline-Modell
                    .cm-value
                        span#cm-ai-state.cm-value-sm -
                    .cm-tile-sub#cm-ai-samples -
                .cm-tile#cm-tile-anomaly
                    .cm-label Anomalie
                    .cm-value
                        span#cm-anomaly -
                    .cm-tile-sub#cm-anomaly-driver -
                .cm-tile
                    .cm-label Vibration
                    .cm-value
                        span#cm-vib -
                        span.cm-unit#cm-vib-unit  g
                        span#cm-vib-trend.cm-trend
                .cm-tile
                    .cm-label Temperatur
                    .cm-value
                        span#cm-temp -
                        span.cm-unit  °C
                .cm-tile
                    .cm-label Trend
                    .cm-value
                        span#cm-trend.cm-value-sm -
                .cm-tile
                    .cm-label Luftfeuchte
                    .cm-value
                        span#cm-humidity -
                        span.cm-unit  %
                .cm-tile#cm-tile-updated
                    .cm-label Letzte Messung
                    .cm-value.cm-value-sm#cm-updated -
                .cm-tile
                    .cm-label Letztes Event
                    .cm-value.cm-value-sm#cm-last-event -

            //- Shown only while the current state is anomalous (OBSERVE or worse) and fresh.
            #cm-why.surface-level-2(style='display:none')
                .cm-section-title Warum ist das auffällig?
                #cm-why-body

            //- 2 CHARTS
            #cm-controls.surface-level-2
                .cm-control-label Zeitraum
                select#cm-range
                    option(value='1') Letzte 1 h
                    option(value='6') Letzte 6 h
                    option(value='12') Letzte 12 h
                    option(value='24' selected) Letzte 24 h
                    option(value='168') Letzte 7 Tage
                    option(value='0') Alle
                .cm-legend
                    span.cm-legend-item
                        span.cm-legend-swatch.cm-normal
                        | Normal
                    span.cm-legend-item
                        span.cm-legend-swatch.cm-warning
                        | Warnung
                    span.cm-legend-item
                        span.cm-legend-swatch.cm-critical
                        | Kritisch

            .cm-charts
                .cm-chart-card.surface-level-2
                    .cm-chart-title Health-Verlauf
                    canvas.cm-chart#cm-chart-health(height='160')
                .cm-chart-card.surface-level-2
                    .cm-chart-title
                        span Vibrationsverlauf (
                        span#cm-vib-chart-unit g
                        span )
                        span.cm-chart-hint  · Band = gelernter Normalbereich
                    canvas.cm-chart#cm-chart-vib(height='160')
                .cm-chart-card.surface-level-2
                    .cm-chart-title Temperaturverlauf (°C)
                    canvas.cm-chart#cm-chart-temp(height='160')
                .cm-chart-card.surface-level-2
                    .cm-chart-title Luftfeuchte-Verlauf (%)
                    canvas.cm-chart#cm-chart-humidity(height='160')

            //- 3 LEARNED BASELINE
            #cm-baseline.surface-level-2
                .cm-section-title Gelernte Baseline
                #cm-baseline-body
                    .cm-events-empty Normalverhalten dieses Assets wird gelernt …
                #cm-learned-fixed
                    .cm-why-head Gelernte Baseline vs. fester Grenzwert
                    .cm-why-line Gelernte Baseline: asset-spezifisches Normalverhalten, gelernt aus aktuellen, unauffälligen Messungen.
                    .cm-why-line Fester Grenzwert: absolute Sicherheitsgrenze, unabhängig vom gelernten Verhalten.

            //- 4 CONDITION EVENTS
            #cm-events.surface-level-2
                .cm-section-title Zustandsereignisse (Condition Events)
                #cm-latest-event
                #cm-events-list
                    .cm-events-empty Noch keine Events.

            //- 5 AI INSIGHT
            #cm-ai-insight.surface-level-2
                .cm-ai-head
                    .cm-section-title KI-Einschätzung
                    .cm-ai-buttons
                        button#cm-ai-explain.button(type='button') Asset-Zustand erklären
                        button#cm-ai-briefing.button(type='button') Techniker-Briefing erstellen
                .cm-ai-note AI Interpretation – keine automatische Diagnose. Nur auf ausdrückliche Anforderung; nichts wird in Fusion Manage geschrieben.
                .cm-ai-status#cm-ai-disabled(style='display:none') AI Insight ist auf diesem Server deaktiviert. Messwerte, Baseline und Condition Events oben bleiben vollständig verfügbar.
                .cm-ai-status#cm-ai-status Nur lesende Erklärung der oben gezeigten Daten.
                #cm-ai-facts(style='display:none')
                #cm-ai-result(style='display:none')
                    .cm-ai-list-title AI Interpretation
                    .cm-ai-summary#cm-ai-summary
                    .cm-case-row
                        span Aktueller Zustand
                        span#cm-ai-current
                    .cm-case-row
                        span Historischer Kontext
                        span#cm-ai-historical
                    .cm-case-row
                        span Menschliche Bewertung
                        span#cm-ai-human
                    .cm-ai-list-title Vorgeschlagene Prüfungen (Vorschläge, keine Schlussfolgerungen)
                    ul#cm-ai-checks
                    .cm-ai-list-title Unsicherheit / Grenzen
                    ul#cm-ai-limitations
                    .cm-case-note#cm-ai-confidence
                #cm-ai-briefing-result(style='display:none')
                    .cm-section-title Techniker-Briefing – AI Interpretation
                    .cm-ai-summary#cm-brief-headline
                    .cm-ai-list-title Aktuelle Situation
                    div#cm-brief-situation
                    .cm-ai-list-title Bekannte Fakten
                    ul#cm-brief-known
                    .cm-ai-list-title Offene Punkte
                    ul#cm-brief-unknown
                    .cm-ai-list-title Empfohlene Prüfungen (Vorschläge, keine Diagnosen)
                    ul#cm-brief-checks
                    .cm-ai-list-title Übergabenotiz
                    div#cm-brief-handover
                    .cm-case-note#cm-brief-confidence

            //- 6 MAINTENANCE CASE
                #cm-chat(style='display:none')

            #cm-maintenance-case.surface-level-2(style='display:none')
                .cm-section-title Historische Erkennung / Maintenance Case
                .cm-case-columns
                    .cm-case-block.cm-machine
                        .cm-case-block-title Historische Erkennung (bei Case-Anlage)
                        .cm-case-row
                            span Case-ID
                            strong#cm-case-id -
                        .cm-case-row
                            span Condition-Event-ID
                            strong#cm-case-event-id -
                        .cm-case-row
                            span Anomalie bei Erkennung
                            strong#cm-case-anomaly -
                        .cm-case-row
                            span Primärer Treiber
                            strong#cm-case-driver -
                    .cm-case-block.cm-human
                        .cm-case-block-title Menschliche Bewertung (hat Vorrang vor dem Modell)
                        .cm-case-row
                            span Workflow
                            strong#cm-case-workflow -
                        .cm-case-row
                            span Dringlichkeit
                            strong#cm-case-urgency -
                        .cm-case-row
                            span Bewertung
                            strong#cm-case-assessment -
                        .cm-case-row
                            span Bestätigte Ursache
                            strong#cm-case-cause -
                .cm-case-note Die Anomalieerkennung zeigt Abweichungen vom gelernten Normalverhalten. Sie diagnostiziert keine Ursache. Ein aktueller NORMAL-Zustand macht diese historische Erkennung nicht ungültig.
                a#cm-case-link.cm-asset-link.cm-fm-link(target='_blank' rel='noopener') In Fusion Manage öffnen – Login erforderlich
            #cm-maintenance-case-message.surface-level-2(style='display:none')
                .cm-section-title Maintenance Case
                .cm-events-empty Maintenance-Case-Daten konnten nicht geladen werden.

            //- Operator-gated Maintenance Case creation from a real durable Condition Event. Preview first,
            //- explicit confirmation, then ONE gated Fusion Manage create. Never automatic, never from AI.
            #cm-case-create.surface-level-2
                .cm-ai-head
                    .cm-section-title Maintenance Case
                    .cm-ai-buttons
                        button#cm-case-btn.button(type='button' disabled) Maintenance Case anlegen
                .cm-ai-note Nur durch Bediener ausgelöst. Das deterministische Condition Event ist die Referenz; der Mensch entscheidet. Ohne ausdrückliche Bestätigung wird nichts geschrieben.
                .cm-ai-status#cm-case-status Nicht angelegt.
                #cm-case-latest.cm-case-latest Keine dauerhafte Eskalation vorhanden.
                #cm-case-preview(style='display:none')
                    .cm-ai-list-title Vorschau – noch nichts geschrieben
                    #cm-case-preview-body
                    label.cm-case-confirm
                        input#cm-case-confirm(type='checkbox')
                        span Mir ist bewusst, dass dadurch ein echtes Fusion-Manage-Item in Asset Services angelegt wird
                    button#cm-case-submit.button(type='button' disabled) In Fusion Manage anlegen
                #cm-case-result(style='display:none')
                    .cm-ai-list-title Ergebnis
                    #cm-case-result-body

            //- 7 ASSET / EXPLANATION DETAILS
            #cm-asset-info.surface-level-2(style='display:none')
                .cm-section-title Asset-Informationen
                .cm-asset-info-grid
                    .cm-info-item
                        .cm-info-label ID
                        .cm-info-value#cm-info-id -
                    .cm-info-item
                        .cm-info-label Fusion Manage
                        a#cm-info-link.cm-info-value.cm-fm-link(target='_blank' rel='noopener') In Fusion Manage öffnen – Login erforderlich
                    .cm-info-item
                        .cm-info-label Titel
                        .cm-info-value#cm-info-title -
                    .cm-info-item
                        .cm-info-label Kunde
                        .cm-info-value#cm-info-customer -
                    .cm-info-item
                        .cm-info-label Projekttyp
                        .cm-info-value#cm-info-project -
                    .cm-info-item
                        .cm-info-label Asset-BOM
                        .cm-info-value#cm-info-asset-bom -
                    .cm-info-item
                        .cm-info-label In Betrieb
                        .cm-info-value#cm-info-operational -
                    .cm-info-item.cm-info-wide
                        .cm-info-label Beschreibung
                        .cm-info-value#cm-info-description -
                    .cm-info-item
                        .cm-info-label Bilder
                        .cm-info-value#cm-info-images -
            #cm-asset-info-message.surface-level-2(style='display:none')
                .cm-section-title Asset-Informationen
                .cm-events-empty Asset-Stammdaten konnten nicht geladen werden.
