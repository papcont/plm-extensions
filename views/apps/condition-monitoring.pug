extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/condition-monitoring.css')

    script(src='/javascripts/apps/condition-monitoring.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Asset health, vibration and temperature from live telemetry
            #header-toolbar
                #cm-source.cm-pill(title='Telemetry source')  source: -
                #cm-pause.button.with-icon.icon-pause(title='Pause / resume all mock data (client poll + unattended server ticker)') Pause
                #cm-reset.button.icon.icon-refresh(title='Restart the demo scenario')
                #header-avatar

        #condition-monitoring

            #cm-asset.surface-level-2(style='display:none')
                .cm-asset-head
                    span.cm-label Asset
                    span#cm-asset-name.cm-asset-name -
                    a#cm-asset-link.cm-asset-link.cm-fm-link(target='_blank' rel='noopener') Open in Fusion Manage — login required
                .cm-sensors
                    .cm-section-title Sensors on this asset
                    #cm-sensors-list
                        .cm-events-empty Loading…

            #cm-asset-info.surface-level-2(style='display:none')
                .cm-section-title Asset information
                .cm-asset-info-grid
                    .cm-info-item
                        .cm-info-label ID
                        .cm-info-value#cm-info-id -
                    .cm-info-item
                        .cm-info-label Fusion Manage
                        a#cm-info-link.cm-info-value.cm-fm-link(target='_blank' rel='noopener') Open in Fusion Manage — login required
                    .cm-info-item
                        .cm-info-label Title
                        .cm-info-value#cm-info-title -
                    .cm-info-item
                        .cm-info-label Customer
                        .cm-info-value#cm-info-customer -
                    .cm-info-item
                        .cm-info-label Project type
                        .cm-info-value#cm-info-project -
                    .cm-info-item
                        .cm-info-label Asset BOM
                        .cm-info-value#cm-info-asset-bom -
                    .cm-info-item
                        .cm-info-label Operational
                        .cm-info-value#cm-info-operational -
                    .cm-info-item.cm-info-wide
                        .cm-info-label Description
                        .cm-info-value#cm-info-description -
                    .cm-info-item
                        .cm-info-label Images
                        .cm-info-value#cm-info-images -
            #cm-asset-info-message.surface-level-2(style='display:none')
                .cm-section-title Asset information
                .cm-events-empty Asset master data could not be loaded.

            .cm-story-label Current machine state

            #cm-summary.surface-level-2
                .cm-tile#cm-tile-status
                    .cm-label Status
                    .cm-status-value
                        span#cm-status-dot.cm-dot
                        span#cm-status-text -
                .cm-tile
                    .cm-label Health
                    .cm-value
                        span#cm-health -
                        span.cm-unit  %
                .cm-tile#cm-tile-ai
                    .cm-label AI model
                    .cm-value
                        span#cm-ai-state.cm-value-sm -
                    .cm-tile-sub#cm-ai-samples -
                .cm-tile#cm-tile-anomaly
                    .cm-label Anomaly
                    .cm-value
                        span#cm-anomaly -
                    .cm-tile-sub#cm-anomaly-driver -
                .cm-tile
                    .cm-label Vibration
                    .cm-value
                        span#cm-vib -
                        span.cm-unit#cm-vib-unit  g
                        span#cm-vib-trend.cm-trend
                .cm-tile
                    .cm-label Temperature
                    .cm-value
                        span#cm-temp -
                        span.cm-unit  °C
                .cm-tile
                    .cm-label Trend
                    .cm-value
                        span#cm-trend.cm-value-sm -
                .cm-tile
                    .cm-label Humidity
                    .cm-value
                        span#cm-humidity -
                        span.cm-unit  %
                .cm-tile
                    .cm-label Last update
                    .cm-value.cm-value-sm#cm-updated -
                .cm-tile
                    .cm-label Last event
                    .cm-value.cm-value-sm#cm-last-event -

            #cm-why.surface-level-2
                .cm-section-title Why is this unusual?
                #cm-why-body
                    .cm-events-empty Learning this asset’s normal behavior…
                #cm-learned-fixed
                    .cm-why-head Learned baseline vs fixed threshold
                    .cm-why-line Learned baseline: asset-specific normal behavior learned from recent healthy observations.
                    .cm-why-line Fixed threshold: an absolute safety guardrail independent of learned behavior.

            #cm-controls.surface-level-2
                .cm-control-label Time range
                select#cm-range
                    option(value='1') Last 1h
                    option(value='6') Last 6h
                    option(value='12') Last 12h
                    option(value='24' selected) Last 24h
                    option(value='168') Last 7d
                    option(value='0') All
                .cm-legend
                    span.cm-legend-item
                        span.cm-legend-swatch.cm-normal
                        | Normal
                    span.cm-legend-item
                        span.cm-legend-swatch.cm-warning
                        | Warning
                    span.cm-legend-item
                        span.cm-legend-swatch.cm-critical
                        | Critical

            .cm-charts
                .cm-chart-card.surface-level-2
                    .cm-chart-title Health trend
                    canvas.cm-chart#cm-chart-health(height='160')
                .cm-chart-card.surface-level-2
                    .cm-chart-title
                        span Vibration trend (
                        span#cm-vib-chart-unit g
                        span )
                        span.cm-chart-hint  · band = learned normal
                    canvas.cm-chart#cm-chart-vib(height='160')
                .cm-chart-card.surface-level-2
                    .cm-chart-title Temperature trend (°C)
                    canvas.cm-chart#cm-chart-temp(height='160')
                .cm-chart-card.surface-level-2
                    .cm-chart-title Humidity trend (%)
                    canvas.cm-chart#cm-chart-humidity(height='160')

            #cm-events.surface-level-2
                .cm-section-title Condition events
                #cm-events-list
                    .cm-events-empty No events yet.

            #cm-maintenance-case.surface-level-2(style='display:none')
                .cm-section-title Historical detection / Maintenance Case
                .cm-case-columns
                    .cm-case-block.cm-machine
                        .cm-case-block-title Historical detection (at case creation)
                        .cm-case-row
                            span Case ID
                            strong#cm-case-id -
                        .cm-case-row
                            span Condition Event ID
                            strong#cm-case-event-id -
                        .cm-case-row
                            span Anomaly at Detection
                            strong#cm-case-anomaly -
                        .cm-case-row
                            span Primary Driver
                            strong#cm-case-driver -
                    .cm-case-block.cm-human
                        .cm-case-block-title Human assessment (outranks the model)
                        .cm-case-row
                            span Workflow
                            strong#cm-case-workflow -
                        .cm-case-row
                            span Urgency
                            strong#cm-case-urgency -
                        .cm-case-row
                            span Assessment
                            strong#cm-case-assessment -
                        .cm-case-row
                            span Confirmed Cause
                            strong#cm-case-cause -
                .cm-case-note Anomaly detection identifies deviations from learned normal behavior. It does not diagnose the cause. A current NORMAL state does not invalidate this historical detection.
                a#cm-case-link.cm-asset-link.cm-fm-link(target='_blank' rel='noopener') Open in Fusion Manage — login required
            #cm-maintenance-case-message.surface-level-2(style='display:none')
                .cm-section-title Maintenance Case
                .cm-events-empty Maintenance Case data could not be loaded.

            #cm-ai-insight.surface-level-2
                .cm-ai-head
                    .cm-section-title AI Insight
                    button#cm-ai-explain.button(type='button') Explain asset state
                .cm-ai-status#cm-ai-status Read-only explanation of the data shown above. Nothing is written to Fusion Manage.
                #cm-ai-result(style='display:none')
                    .cm-ai-summary#cm-ai-summary
                    .cm-case-row
                        span Current state
                        span#cm-ai-current
                    .cm-case-row
                        span Historical context
                        span#cm-ai-historical
                    .cm-case-row
                        span Human assessment
                        span#cm-ai-human
                    .cm-ai-list-title Suggested checks (suggestions, not conclusions)
                    ul#cm-ai-checks
                    .cm-ai-list-title Limitations
                    ul#cm-ai-limitations
                    .cm-case-note#cm-ai-confidence
