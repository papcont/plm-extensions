extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/test-validation-hub.css')
    link(rel='stylesheet', href='/stylesheets/custom/test-validation-hub.css')

    script(src='/javascripts/apps/test-validation-hub.js')
    script(src='/javascripts/custom/test-validation-hub.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Test records, meetings, linked items, and closure evidence
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #test-validation-hub
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Validate VisiTEST workspace IDs and evidence links before adding meeting minutes, result updates, or workflow transitions.
