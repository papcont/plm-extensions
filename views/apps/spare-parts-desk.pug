extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/spare-parts-desk.css')
    link(rel='stylesheet', href='/stylesheets/custom/spare-parts-desk.css')

    script(src='/javascripts/apps/spare-parts-desk.js')
    script(src='/javascripts/custom/spare-parts-desk.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Spare-part demand, service context, sourcing, and engineering follow-up
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #spare-parts-desk
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Validate request, item, service, and supplier-package links before adding handoff actions to Problem Reports or Change Requests.
