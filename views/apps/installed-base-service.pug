extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/installed-base-service.css')
    link(rel='stylesheet', href='/stylesheets/custom/installed-base-service.css')

    script(src='/javascripts/apps/installed-base-service.js')
    script(src='/javascripts/custom/installed-base-service.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Installed base, service, serial, and asset workspace readiness
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #installed-base-service
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Select a workspace card to open the existing navigator or service context. Add write actions only after this view proves useful in the tenant.
