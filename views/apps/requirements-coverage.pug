extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/requirements-coverage.css')
    link(rel='stylesheet', href='/stylesheets/custom/requirements-coverage.css')

    script(src='/javascripts/apps/requirements-coverage.js')
    script(src='/javascripts/custom/requirements-coverage.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Requirements, design records, review tasks, validation evidence, and change context
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #requirements-coverage
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Validate requirement, item, review, test, and change links before adding link creation, requirement updates, or verification-state changes.
