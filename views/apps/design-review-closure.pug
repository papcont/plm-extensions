extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/apps/design-review-closure.css')
    link(rel='stylesheet', href='/stylesheets/custom/design-review-closure.css')

    script(src='/javascripts/apps/design-review-closure.js')
    script(src='/javascripts/custom/design-review-closure.js')

block body

    body.surface-level-1

        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle Design review, task, and closure readiness
            #header-toolbar
                #refresh.button.icon.icon-refresh(title='Refresh workspace counters')
                #header-avatar

        #design-review-closure
            #summary.surface-level-2
                .summary-tile
                    .summary-label Workspaces
                    .summary-value#workspace-count -
                .summary-tile
                    .summary-label Records
                    .summary-value#record-count -
                .summary-tile
                    .summary-label Readiness
                    .summary-value#readiness -

            #workspace-grid

            #next-slice.surface-level-2
                .section-title Next read-only slice
                .section-text Use these review and task workspaces to validate closure signals before adding review/task write actions.
